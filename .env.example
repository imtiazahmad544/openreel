# OpenReel configuration. EVERYTHING works with $0 — keys below are optional
# free-tier upgrades. Copy to .env and fill what you want.

# --- Script generation (default: Pollinations, free, no key) ---
# OPENREEL_LLM=pollinations          # pollinations | gemini | ollama | echo
# GEMINI_API_KEY=                    # free tier: https://aistudio.google.com
# OLLAMA_MODEL=llama3.1             # local: needs `ollama serve` running

# --- Stock footage (optional free API keys — generous free tiers) ---
# PEXELS_API_KEY=                    # https://www.pexels.com/api/
# PIXABAY_API_KEY=                   # https://pixabay.com/api/docs/

# --- Voice (default: edge-tts, free, no key) ---
# OPENREEL_VOICE=en-US-AndrewMultilingualNeural
# OPENREEL_TTS=edge                 # edge | piper
# PIPER_MODEL=                       # path to .onnx voice model for offline use

# --- Pipeline defaults ---
# OPENREEL_ASPECT=16:9               # 16:9 | 9:16
# OPENREEL_FPS=30
# OPENREEL_VISUAL_MODE=auto          # auto | stock | ai | mix
